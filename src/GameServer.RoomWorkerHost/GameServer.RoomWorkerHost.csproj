<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- A stable assembly name so the parent can launch it by a known dll path. -->
    <AssemblyName>GameServer.RoomWorkerHost</AssemblyName>
  </PropertyGroup>

  <!-- Composition root for the out-of-process worker: exempt from the layering rule; wires
       a concrete game (Simulation) into the room host (Transport) over IPC. -->
  <ItemGroup>
    <ProjectReference Include="..\GameServer.Abstractions\GameServer.Abstractions.csproj" />
    <ProjectReference Include="..\GameServer.Transport\GameServer.Transport.csproj" />
    <ProjectReference Include="..\GameServer.Simulation\GameServer.Simulation.csproj" />
  </ItemGroup>

</Project>
