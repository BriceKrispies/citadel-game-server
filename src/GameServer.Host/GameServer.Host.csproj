<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Thin host / composition root: it wires and adapts the existing kernel; it owns no
         game logic. As a composition root it is exempt from the layering rule and may
         reference every ring to wire concrete implementations to their kernel ports. -->
    <ProjectReference Include="..\GameServer.Abstractions\GameServer.Abstractions.csproj" />
    <ProjectReference Include="..\GameServer.Protocol\GameServer.Protocol.csproj" />
    <ProjectReference Include="..\GameServer.Identity\GameServer.Identity.csproj" />
    <ProjectReference Include="..\GameServer.Transport\GameServer.Transport.csproj" />
    <ProjectReference Include="..\GameServer.Tenancy\GameServer.Tenancy.csproj" />
    <ProjectReference Include="..\GameServer.Routing\GameServer.Routing.csproj" />
    <ProjectReference Include="..\GameServer.Simulation\GameServer.Simulation.csproj" />
    <ProjectReference Include="..\GameServer.ControlPlane\GameServer.ControlPlane.csproj" />
    <ProjectReference Include="..\GameServer.Persistence\GameServer.Persistence.csproj" />
    <ProjectReference Include="..\GameServer.Persistence.Postgres\GameServer.Persistence.Postgres.csproj" />
    <ProjectReference Include="..\GameServer.Observability\GameServer.Observability.csproj" />
    <ProjectReference Include="..\GameServer.Cluster.Redis\GameServer.Cluster.Redis.csproj" />
  </ItemGroup>

</Project>
