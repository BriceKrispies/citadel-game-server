<Project Sdk="Microsoft.NET.Sdk">

  <!-- Durable persistence adapter (rank 1): EF Core + Npgsql implementations of the rank-0
       Abstractions persistence ports (ISnapshotStore / IEventLog) plus the durable record model
       (tenant / game / game-version / room / session / audit). Strict adjacency: references only
       the universal kernel (GameServer.Abstractions). Wired only at composition roots (the Host). -->
  <ItemGroup>
    <ProjectReference Include="..\GameServer.Abstractions\GameServer.Abstractions.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- EF Core Design pulls a vulnerable System.Security.Cryptography.Xml 9.0.0 transitively
         (NU1903; the repo treats NuGet audit warnings as errors). Pin the patched 10.0.8 to
         override it. Design-time only (PrivateAssets=all), so this never reaches consumers. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.8">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
