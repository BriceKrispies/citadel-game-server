  "invariantEvidence": {
    "tenant-isolation": { "notes": "Strong pattern: read-room and delete-session derive tenant from the STORED record (room.TenantId/session.TenantId), not the route, so a guessed id cannot reach another tenant's resource. The two admin route-param endpoints DO check route tenantId via Forbid(). Admin list filters every ActiveRoom and Hottest stat through CanActFor before exposing it.", "forbidLogic": "Program:Forbid -> CallerPrincipal.CanActFor", "tenantScopedPorts": ["InMemoryRoomRegistry", "InMemorySessionRegistry"], "routeTenantCheckedAt": ["GET/observe admin endpoints"] },
