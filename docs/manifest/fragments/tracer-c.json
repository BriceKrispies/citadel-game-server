    "authz": { "authenticator": "ApiKeyControlPlaneAuthenticator", "principal": "CallerPrincipal", "roles": ["PlatformAdminRole"], "denialSites": ["Program:Forbid"] },
    "protocol-typing": { "dtos": ["ApiContracts (control plane)"], "stringlyTypedFound": ["Program:Audit target=\"*\" for admin list", "RoomScopedMetrics.TenantOf splits label on '/'", "admin list/hottest responses use anonymous objects, not named DTOs"] },
    "backpressure": { "admissionChecks": ["IRoomPlacement.Place -> 503 ClusterAtCapacity"] }
