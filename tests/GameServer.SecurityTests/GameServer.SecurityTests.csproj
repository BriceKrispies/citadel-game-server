<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Black-box pentest suite. NOT in the fast unit loop: it drives a RUNNING container over
         real HTTP + WebSocket. Every test skips unless CITADEL_SECURITY_TARGET is set, so a
         repo-wide `dotnet test` (with no target) stays green. Run via scripts/security-test.ps1. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Build valid + malformed wire frames with the REAL codec/mapper, and mint forged/expired
       tokens with the REAL token codec. Abstractions is pulled in transitively (IClock, ports). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\GameServer.Abstractions\GameServer.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Protocol\GameServer.Protocol.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Transport\GameServer.Transport.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Identity\GameServer.Identity.csproj" />
  </ItemGroup>

</Project>
