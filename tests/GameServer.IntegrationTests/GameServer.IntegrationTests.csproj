<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Scenario tests do real wall-clock/CPU work and write artifacts; keep them out of
         the fast unit loop (run this project explicitly). -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageReference Include="Testcontainers.Redis" Version="4.12.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.61" />
  </ItemGroup>

  <!-- WebApplicationFactory<Program> boots the real Host in-process; that requires the
       ASP.NET Core shared framework and a reference to the Host entry-point assembly. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GameServer.Abstractions\GameServer.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Host\GameServer.Host.csproj" />
    <!-- Referenced so the child worker executable is built and copied next to the test
         binaries, where the cross-process scenario launches it by dll path. -->
    <ProjectReference Include="..\..\src\GameServer.RoomWorkerHost\GameServer.RoomWorkerHost.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Protocol\GameServer.Protocol.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Transport\GameServer.Transport.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Tenancy\GameServer.Tenancy.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Routing\GameServer.Routing.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Simulation\GameServer.Simulation.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Persistence\GameServer.Persistence.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Persistence.Postgres\GameServer.Persistence.Postgres.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Observability\GameServer.Observability.csproj" />
    <ProjectReference Include="..\..\src\GameServer.ControlPlane\GameServer.ControlPlane.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Replication\GameServer.Replication.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Identity\GameServer.Identity.csproj" />
    <ProjectReference Include="..\..\src\GameServer.Cluster.Redis\GameServer.Cluster.Redis.csproj" />
  </ItemGroup>

</Project>
